---
import { resume, formatRange } from '../data/resume';

const { education, awards } = resume;
---

<div class="credentials">
  <div class="column">
    <h3 class="column__name">education</h3>
    <ul class="entries">
      {
        education.map((entry) => (
          <li class="entry">
            <div class="entry__head">
              <h4 class="entry__title">{entry.institution}</h4>
              <span class="entry__meta">{formatRange(entry.startDate, entry.endDate)}</span>
            </div>
            <p class="entry__detail">
              {[entry.studyType, entry.area].filter(Boolean).join(', ')}
              {entry.location && <span class="entry__sub"> · {entry.location}</span>}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="column">
    <h3 class="column__name">awards</h3>
    <ul class="entries">
      {
        awards.map((award) => (
          <li class="entry">
            <div class="entry__head">
              <h4 class="entry__title">{award.title}</h4>
              <span class="entry__meta">{award.date}</span>
            </div>
            {award.summary && <p class="entry__detail">{award.summary}</p>}
            {award.awarder && <p class="entry__sub">{award.awarder}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .credentials {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 46rem) {
    .credentials {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  .column__name {
    margin-bottom: 0.9rem;
    color: var(--fg-subtle);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .column__name::before {
    content: '# ';
    color: var(--accent);
  }

  .entries {
    display: grid;
    gap: 1.25rem;
  }

  .entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 1rem;
  }

  .entry__title {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .entry__meta {
    color: var(--fg-subtle);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .entry__detail {
    margin: 0.35rem 0 0;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  .entry__sub {
    margin: 0.2rem 0 0;
    color: var(--fg-subtle);
    font-size: 0.78rem;
  }

  @media print {
    .credentials {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .entries {
      gap: 0.75rem;
    }
  }
</style>
