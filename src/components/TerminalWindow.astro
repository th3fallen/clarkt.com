---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  path: string;
}

const { path } = Astro.props;
---

<div class="window">
  <div class="window__chrome no-print">
    <div class="window__lights" aria-hidden="true">
      <span class="window__light window__light--close"></span>
      <span class="window__light window__light--min"></span>
      <span class="window__light window__light--max"></span>
    </div>
    <div class="window__title">{path}</div>
    <ThemeToggle />
  </div>

  <div class="window__body">
    <slot />
  </div>
</div>

<style>
  .window {
    max-width: 62rem;
    margin: 0 auto;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    /* Deliberately NOT `overflow: hidden` — an overflow ancestor becomes the
       containing block for `position: sticky`, which silently kills the sticky
       titlebar below. Corners are rounded on the children instead. */
  }

  .window__chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    background: var(--chrome);
    border-bottom: 1px solid var(--border);
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .window__lights {
    display: flex;
    gap: 0.45rem;
  }

  .window__light {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .window__light--close {
    background: #ec6a5e;
  }

  .window__light--min {
    background: #f4bf4f;
  }

  .window__light--max {
    background: #61c454;
  }

  .window__title {
    color: var(--fg-subtle);
    font-size: 0.75rem;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Toggle sits in the third column; push it to the right edge. */
  .window__chrome > :global(:last-child) {
    justify-self: end;
  }

  .window__body {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 0 0 calc(var(--radius) - 1px) calc(var(--radius) - 1px);
  }

  @media print {
    .window {
      max-width: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .window__body {
      padding: 0;
    }
  }
</style>
